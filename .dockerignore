node_modules
packages/*/node_modules
packages/electron/out
packages/electron/resources/node
packages/electron/resources/icons
packages/electron/resources/server
packages/electron/.vite
dist
.git
.pi
# ...except the skill scripts, which are part of the module graph the dead-code
# oracle analyses (knip.json roots `.pi/skills/**/scripts/*.ts`). Everything
# else under .pi stays out — notably settings.json, which pins a HOST absolute
# path for its extension packages and would break container sessions.
# See change: add-knip-dead-code-oracle.
!.pi/skills
openspec

# scripts/build-image.sh: its output/evidence are not build inputs, and the script itself
# stays out of the image so /app/scripts matches the running build.
out/
runs/
scripts/build-image.sh
